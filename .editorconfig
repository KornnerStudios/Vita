# EditorConfig is awesome: https://EditorConfig.org

# top-most EditorConfig file
root = true

[*]
	# newline ending every file
		insert_final_newline = true
		end_of_line = crlf
	# I prefer tabs, with my view set to 4 spaces. YMMV.
		indent_style = tab
		tab_width = 4
		indent_size = 4
	# I do not like green eggs nor ham, nor trailing whitespace
		trim_trailing_whitespace = true

	# Non-standard configs

	# I do not like K&R bracing
		curly_bracket_next_line = true
		indent_brace_style = Allman

[*.{xml,yml,runsettings}]
		indent_style = space
		indent_size = 2

[*]
	#### C# specific rules ####
		csharp_indent_case_contents = true
		csharp_indent_case_labels = true
		csharp_prefer_braces = true:suggestion
		csharp_space_after_keywords_in_control_flow_statements = true
		csharp_space_after_semicolon_in_for_statement = true
	#### .NET Coding Conventions ####
		dotnet_remove_unnecessary_suppression_exclusions = none
		dotnet_style_namespace_match_folder = false:suggestion
		dotnet_style_prefer_compound_assignment = false:suggestion
	#### Diagnostic configuration ####
		dotnet_diagnostic.CA1822.severity = silent
		# "Collection initialization can be simplified"
		dotnet_diagnostic.IDE0028.severity = silent
		# "Indexing can be simplified"
		dotnet_diagnostic.IDE0056.severity = silent
		# "Substring can be simplified"
		dotnet_diagnostic.IDE0057.severity = silent
		# "Using statement can be simplified"
		dotnet_diagnostic.IDE0063.severity = silent
		# "Conditional expression can be simplified"
		dotnet_diagnostic.IDE0075.severity = silent
		# "Remove unnecessary suppression"
		# setting this to silent instead of suggestion, as with .net9 port it is misfiring on things
		dotnet_diagnostic.IDE0079.severity = silent
		dotnet_diagnostic.IDE0130.severity = none
		dotnet_diagnostic.IDE0290.severity = none #  Use primary constructor
		# "Collection initialization can be simplified"
		dotnet_diagnostic.IDE0305.severity = silent
		dotnet_diagnostic.IDE0306.severity = silent

		# CA1707 "Identifiers should not contain underscores": Wwise/vendor, wire-format, and legacy test identifiers
		# intentionally preserve external spelling; renaming them would obscure source-data correspondence.
		dotnet_diagnostic.CA1707.severity = none
		# CA1303 "Do not pass literals as localized parameters": Vita has no localization product contract for its
		# internal tools, diagnostics, tests, or format messages.
		dotnet_diagnostic.CA1303.severity = none
		# CA1002 "Do not expose generic lists": mutable List<T> members are intentional internal format-model shapes.
		dotnet_diagnostic.CA1002.severity = none
		# CA1051 "Do not declare visible instance fields": visible fields intentionally model serialized and interop data.
		dotnet_diagnostic.CA1051.severity = none
		# CA1515 "Consider making public types internal": test discovery, WPF/XAML, and composition frameworks
		# require public types even when they are not conventional cross-assembly APIs.
		dotnet_diagnostic.CA1515.severity = none
		# CA1711 "Identifiers should not have incorrect suffix": stream, delegate, flag, and implementation suffixes
		# describe established serialization and framework conventions that cannot be safely renamed wholesale.
		dotnet_diagnostic.CA1711.severity = none
		# CA1712 "Do not prefix enum values with type name": native API and serialized-format enums preserve
		# vendor spelling for compatibility and direct correspondence with external documentation.
		dotnet_diagnostic.CA1712.severity = none
		# CA1720 "Identifiers should not contain type names": numeric and object type names intentionally
		# communicate binary-layout, serialized-value, and interop semantics.
		dotnet_diagnostic.CA1720.severity = none
		# CA1308 "Normalize strings to uppercase": lowercase command tokens, XML names, extensions, and
		# generated identifiers are intentional compatibility and format conventions.
		dotnet_diagnostic.CA1308.severity = none
		# CA1805 "Do not initialize unnecessarily": explicit defaults document None/Empty sentinels,
		# serialized option state, and UI/model initialization contracts.
		dotnet_diagnostic.CA1805.severity = none
		# CA1819 "Properties should not return arrays": array properties intentionally expose serialized
		# buffers, mutable metadata, and UI binding data.
		dotnet_diagnostic.CA1819.severity = none
		# CA1028 "Enum storage should be Int32": non-Int32 underlying types preserve native ABI,
		# binary resource layout, compact serialization, and version/signature widths.
		dotnet_diagnostic.CA1028.severity = none
		# CA1008 "Enums should have zero value": zero is often a wire/native domain value or intentionally
		# invalid, rather than a generic None sentinel.
		dotnet_diagnostic.CA1008.severity = none
